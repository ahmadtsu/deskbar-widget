<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Adapted from EverythingToolbar Win11 Dark theme tokens (MIT © 2023 Stephan Rumswinkel). See ATTRIBUTION.md. -->
  <SolidColorBrush x:Key="TileBackground" Color="#11ffffff" />
  <SolidColorBrush x:Key="TileBackgroundHover" Color="#16ffffff" />
  <SolidColorBrush x:Key="TileBackgroundPressed" Color="#0cffffff" />
  <SolidColorBrush x:Key="TileForeground" Color="#dadada" />
  <SolidColorBrush x:Key="TileBorder" Color="#19ffffff" />
  <CornerRadius x:Key="TileCornerRadius">8,8,8,8</CornerRadius>
  <sys:Double x:Key="TileSize">28</sys:Double>
  <Thickness x:Key="TileGap">0,0,8,0</Thickness>
  <FontFamily x:Key="TileFontFamily">Segoe UI Variable Text</FontFamily>
  <sys:Double x:Key="TileFontSize">12</sys:Double>
  <FontWeight x:Key="TileFontWeight">SemiBold</FontWeight>

  <!-- Context menu tokens adapted from EverythingToolbar Win11 Dark (MIT). -->
  <SolidColorBrush x:Key="ContextMenuBackground" Color="#2e2e2e" />
  <SolidColorBrush x:Key="ContextMenuBorder" Color="#1d1d1d" />
  <SolidColorBrush x:Key="ContextMenuSeparator" Color="#3e3e3e" />
  <SolidColorBrush x:Key="ContextMenuItemBackgroundHover" Color="#383838" />
  <SolidColorBrush x:Key="ContextMenuItemForeground" Color="#D8D8D8" />
  <SolidColorBrush x:Key="ContextMenuItemForegroundHover" Color="#d8d8d8" />
  <CornerRadius x:Key="ContextMenuCornerRadius">8,8,8,8</CornerRadius>
  <CornerRadius x:Key="ContextMenuMenuItemCornerRadius">5,5,5,5</CornerRadius>
</ResourceDictionary>
