<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Adapted from EverythingToolbar Win11 Light theme tokens (MIT © 2023 Stephan Rumswinkel). See ATTRIBUTION.md. -->
  <SolidColorBrush x:Key="TileBackground" Color="#c0ffffff" />
  <SolidColorBrush x:Key="TileBackgroundHover" Color="#ccf9f9f9" />
  <SolidColorBrush x:Key="TileBackgroundPressed" Color="#ffffff" />
  <SolidColorBrush x:Key="TileForeground" Color="#1b1b1b" />
  <SolidColorBrush x:Key="TileBorder" Color="#9bcfcfcf" />
  <CornerRadius x:Key="TileCornerRadius">8,8,8,8</CornerRadius>
  <sys:Double x:Key="TileSize">28</sys:Double>
  <Thickness x:Key="TileGap">0,0,8,0</Thickness>
  <FontFamily x:Key="TileFontFamily">Segoe UI Variable Text</FontFamily>
  <sys:Double x:Key="TileFontSize">12</sys:Double>
  <FontWeight x:Key="TileFontWeight">SemiBold</FontWeight>

  <!-- Context menu tokens adapted from EverythingToolbar Win11 Light (MIT). -->
  <SolidColorBrush x:Key="ContextMenuBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="ContextMenuBorder" Color="#C2C2C2" />
  <SolidColorBrush x:Key="ContextMenuSeparator" Color="#C2C2C2" />
  <SolidColorBrush x:Key="ContextMenuItemBackgroundHover" Color="#DBDBDB" />
  <SolidColorBrush x:Key="ContextMenuItemForeground" Color="#000000" />
  <SolidColorBrush x:Key="ContextMenuItemForegroundHover" Color="#000000" />
  <CornerRadius x:Key="ContextMenuCornerRadius">8,8,8,8</CornerRadius>
  <CornerRadius x:Key="ContextMenuMenuItemCornerRadius">5,5,5,5</CornerRadius>
</ResourceDictionary>
