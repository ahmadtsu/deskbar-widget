<UserControl x:Class="DeskbarWidget.App.DesktopsStrip"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeskbarWidget.App"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="TileButtonStyle" TargetType="local:TileButton">
            <Setter Property="Width" Value="{DynamicResource TileSize}" />
            <Setter Property="Height" Value="{DynamicResource TileSize}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{DynamicResource TileFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TileFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource TileFontWeight}" />
            <Setter Property="Foreground" Value="{DynamicResource TileForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TileButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource TileBackground}"
                                BorderBrush="{DynamicResource TileBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource TileCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileBackgroundHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileActiveBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TileActiveForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ItemsControl x:Name="Tiles" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
